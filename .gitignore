__pycache__/
*.pyc
.pytest_cache/
build/
*.egg-info/

# benchmark/ is the corpus this tool is developed against. The REAL projects
# (006+) are whole third-party checkouts and are NOT tracked; the five minimal
# SAMPLES are the reference shapes and ARE tracked -- as SOURCE only.
benchmark/*
!benchmark/benchmark.csv
!benchmark/001-minFortran/
!benchmark/002-minCpp/
!benchmark/003-goldenDemo/
!benchmark/004-goldenChain/
!benchmark/005-goldenField/

# Generated protocols are OUTPUT, not source -- never tracked.
benchmark/*/protocol.json
benchmark/*/verification_plan.json
benchmark/*/origin_release/
benchmark/*/.work/
benchmark/*/results/
benchmark/*/benchmark_results/

# The regression script names the corpus's real projects and their build
# systems (it is the corpus, not the tool), so it is a working artifact of
# THIS checkout rather than part of the language-agnostic repo.  It stays on
# disk and is run from here; `CLAUDE.md` says what it is for.
regress.sh

# 012's prepare ops and verify driver, written by regress.sh (outside benchmark/ so wipe leaves them)
.corpus-012/
